{
  "claude": {
    "command": [
      "claude",
      "--disable-slash-commands",
      "--print",
      "--output-format",
      "json",
      "--no-session-persistence",
      "--setting-sources",
      "",
      "--model",
      "claude-opus-5",
      "--permission-mode",
      "acceptEdits",
      "--allowedTools",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep"
    ],
    "response_format": "claude-json",
    "budget_flag": "--max-budget-usd"
  },
  "codex": {
    "command": [
      "codex",
      "exec",
      "--ephemeral",
      "--ignore-user-config",
      "--sandbox",
      "read-only",
      "--skip-git-repo-check",
      "--json"
    ],
    "response_format": "codex-jsonl"
  }
}
